programa {
  funcao inicio() {
    real a, b, c
    escreva("insira um numero:")
    leia(a)
    escreva("insira o segundo numero:")
    leia(b)
    escreva("insira o terceiro numero:")
    leia(c)

      se ( a > b e a > c)
      escreva(a, " é o maior entre os 3 numeros!")
      se (b > a e b > c)
      escreva(b, "é o maior entre os 3 numeros!")
      se (c > b e c > a)
      escreva(c, " é o maior entre os 3 numeros!")
    
  }
}
