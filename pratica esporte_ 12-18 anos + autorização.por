programa {
  funcao inicio() {
real idade
cadeia autorizacao
escreva("quantos anos voce tem? ")
  leia (idade)
escreva("voce tem autorização? ")
  leia (autorizacao)
se (idade >= 12 e idade <=18 e autorizacao == "sim")
  escreva("voce pode praticar esportes!")
senao 
  escreva("voce nao pode praticar esportes!")
  }
}
