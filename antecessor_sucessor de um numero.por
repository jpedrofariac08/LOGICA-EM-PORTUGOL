programa {
  funcao inicio() {
    real a, antecessor, sucessor
    escreva("digite um numero:")
    leia (a)
    antecessor = a - 1
    escreva ("\no numero antecessor do numero digitado é:", antecessor)
     sucessor = a + 1
    escreva ("\no numero antecessor do numero digitado é:", sucessor)
  }
}
