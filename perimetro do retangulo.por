programa {
  funcao inicio() {
    real ladoA, ladoB, lado1, lado2, perimetro
    escreva("insira o lado A do retangulo:")
    leia (ladoA)
    escreva("insira o lado B do retangulo:")
    leia (ladoB)
    escreva("insira o lado 1 do retangulo:")
    leia (lado1)
    escreva("insira o lado 2 do retangulo:")
    leia (lado2)
    perimetro = (ladoA + ladoB + lado1 + lado2)

    escreva("o perimetro do retangulo é:", perimetro)
  }
}
